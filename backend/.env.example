# Copy to .env. Defaults match docker-compose (Postgres on host port 5433).
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5433/budget
# Comma-separated origins allowed by CORS (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Google SSO ---
# OAuth 2.0 Web client from Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte string used to sign the session cookie. Generate per environment.
SECRET_KEY=change-me-to-a-long-random-string
# Public origin used to build the OAuth redirect URI sent to Google.
# Local dev: http://localhost:8000  (callback hits uvicorn directly — no proxy)
# Production (Render): https://<your-app>.onrender.com
# Register PUBLIC_BASE_URL/api/auth/callback in Google Cloud Console > Authorized redirect URIs.
PUBLIC_BASE_URL=http://localhost:8000
# Where to redirect the browser after a successful login.
# Local dev: http://localhost:5173  (the Vite dev server)
# Production: /  (same origin — leave as default)
FRONTEND_URL=http://localhost:5173
# Comma-separated allowlist of Google emails permitted to sign in.
# Add friends'/family Google emails here to let them use the app, e.g.
# ALLOWED_EMAILS=you@gmail.com,friend@gmail.com,family@gmail.com
ALLOWED_EMAILS=

# --- Encryption at rest (money values) ---
# Fernet key used to encrypt all amounts in the DB. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable and backed up: losing it makes every stored amount permanently
# unreadable. It lives only here (server env), never in the database.
ENCRYPTION_KEY=

# --- AI budget generation (onboarding) ---
# OpenAI API key used for "Build with AI" and "Revise with AI".
# Optional: if blank or the call fails, both fall back to a deterministic split.
OPENAI_API_KEY=
# Models (override to pin different ones without a code change).
# Build = initial allocation (cheap one-shot JSON); Revise = reasoning over spending history.
OPENAI_MODEL_BUILD=gpt-5.4-nano
OPENAI_MODEL_REVISE=gpt-5.4-mini
