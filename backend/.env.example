# Copy to .env. Defaults match docker-compose (Postgres on host port 5433).
DATABASE_URL=postgresql+psycopg://budget:budget@localhost:5433/budget
# Comma-separated origins allowed by CORS (Vite dev server).
CORS_ORIGINS=http://localhost:5173

# --- Google SSO ---
# OAuth 2.0 Web client from Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ byte string used to sign the session cookie. Generate per environment.
SECRET_KEY=change-me-to-a-long-random-string
# Public origin used to build the OAuth redirect URI. Local: http://localhost:8000
# On Render: https://<your-app>.onrender.com
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated allowlist of Google emails permitted to sign in.
ALLOWED_EMAILS=akshatav56@gmail.com
